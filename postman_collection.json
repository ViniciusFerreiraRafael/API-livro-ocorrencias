            "description": "Retorna a lista completa de turmas com os alunos atrelados. Esperado: 200 OK."
          }
        },
        {
          "name": "GET - Buscar Turma por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/turmas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turmas", "1"]
            },
            "description": "Retorna a turma com Id=1. Esperado: 200 OK. Se não existir: 404 Not Found."
          }
        },
        {
