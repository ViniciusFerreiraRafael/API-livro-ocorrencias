            "url": {
              "raw": "{{baseUrl}}/api/turmas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turmas"]
            },
            "description": "Cria uma nova turma. Esperado: 201 Created com o objeto criado no body."
          }
        },
        {
          "name": "PUT - Atualizar Turma",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"nome\": \"3º Ano - EE. Prof Theodorico de Oliveira\",\n  \"anoLetivo\": 2026,\n  \"turno\": \"Manhã\"\n}",
              "options": {
