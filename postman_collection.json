                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/turmas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turmas", "1"]
            },
            "description": "Atualiza a turma com Id=1. O campo 'id' no body deve ser igual ao da URL. Esperado: 204 No Content."
          }
        },
        {
          "name": "DELETE - Remover Turma",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/turmas/2",
