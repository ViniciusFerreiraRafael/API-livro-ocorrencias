          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"2º Ano A - EE. Prof Theodorico de Oliveira\",\n  \"anoLetivo\": 2026,\n  \"turno\": \"Tarde\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
