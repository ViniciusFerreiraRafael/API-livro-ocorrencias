      "name": "Turmas",
      "description": "CRUD completo da entidade Turma.",
      "item": [
        {
          "name": "GET - Listar todas as Turmas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/turmas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turmas"]
